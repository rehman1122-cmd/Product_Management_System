@page "{id:int}"
@model ProductManager.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<div class="form-page">
    <a class="back-link" asp-page="/Index">← Back to products</a>
    <section class="detail-card">
        <div class="detail-heading">
            <div>
                <p class="eyebrow">PRODUCT DETAILS</p>
                <h1>@Model.Product.Name</h1>
                <span class="category-pill">@Model.Product.Category</span>
            </div>
            <a class="button button-secondary" asp-page="./Edit" asp-route-id="@Model.Product.Id">Edit product</a>
        </div>
        <dl class="detail-grid">
            <div>
                <dt>Price</dt>
                <dd>@Model.Product.Price.ToString("C2")</dd>
            </div>
            <div>
                <dt>Stock</dt>
                <dd>@Model.Product.Stock</dd>
            </div>
            <div class="detail-description">
                <dt>Description</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Product.Description) ? "No description provided." : Model.Product.Description)</dd>
            </div>
        </dl>
        <a class="text-action text-action-muted" asp-page="./Delete" asp-route-id="@Model.Product.Id">Delete this product</a>
    </section>
</div>
